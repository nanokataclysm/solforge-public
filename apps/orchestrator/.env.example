# Qwen / DashScope planner configuration.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
QWEN_MODEL=qwen-plus
QWEN_PLANNER_MODEL=qwen-plus
QWEN_REPAIR_MODEL=qwen-turbo
QWEN_NAVIGATOR_MODEL=qwen-turbo

# Application access and runtime mode.
DEMO_SHARED_SECRET=
NODE_ENV=

# Required together for auth sessions, approval sessions, and the distributed
# login limiter in multi-instance Preview and Production deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required together for signed package creation on Vercel. Store encrypted PEM
# values; never commit key material or copy private keys into logs.
NANOKAT_SIGNING_PRIVATE_KEY_PEM=
NANOKAT_SIGNING_PUBLIC_KEY_PEM=

# Required together to enable verified-media B2 metadata checks. Use a
# readFiles-only application key restricted to one bucket and the intended
# object-name prefix.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
