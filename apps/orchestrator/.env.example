# Required runtime configuration. Use real values only in private environment
# configuration; never commit them.
DEMO_SHARED_SECRET=replace-in-private-runtime
DASHSCOPE_API_KEY=replace-in-private-runtime
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Preferred durable store for both auth and approval sessions.
SOLFORGE_DATABASE_URL=postgresql://replace-in-private-runtime

# Atomic Upstash fallback when Neon is not configured. Set both or neither.
# The same credentials also back the distributed login rate limiter.
# UPSTASH_REDIS_REST_URL=https://replace-in-private-runtime
# UPSTASH_REDIS_REST_TOKEN=replace-in-private-runtime

# Optional login limiter tuning. Defaults: 5 attempts per 300000 ms.
# LOGIN_RATE_MAX=5
# LOGIN_RATE_WINDOW_MS=300000

# Cookies are automatically Secure in production and on Vercel.
FORCE_SECURE_COOKIES=true

# Proxy trust: Vercel automatically uses one trusted hop. For Cloud Run or
# another load balancer, leave unset unless its exact trusted hop count is known.
# SOLFORGE_TRUST_PROXY_HOPS=1
