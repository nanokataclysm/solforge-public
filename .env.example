# Required runtime configuration. Never commit real values.
DEMO_SHARED_SECRET=replace-in-private-runtime
DASHSCOPE_API_KEY=replace-in-private-runtime
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Required together in production for auth sessions, approval sessions, and
# distributed login rate limiting.
UPSTASH_REDIS_REST_URL=https://replace-in-private-runtime
UPSTASH_REDIS_REST_TOKEN=replace-in-private-runtime

# Optional login limiter tuning. Defaults: 5 attempts per 300000 ms.
# LOGIN_RATE_MAX=5
# LOGIN_RATE_WINDOW_MS=300000

FORCE_SECURE_COOKIES=true
# SOLFORGE_TRUST_PROXY_HOPS=1
